# Plantilla. Copiar a `keystore.properties` (gitignorado) y completar.
#
# REGLA 3: este archivo con valores reales NO entra a git, ni al vault, ni a
# Notion. Lo que se archiva es el puntero: dónde está el keystore y cómo se
# obtiene su clave. Nunca cuál es.
#
# El keystore mismo tiene que vivir FUERA del repo. Si se pierde, no se puede
# volver a publicar una actualización de la app nunca más: Play Store identifica
# la app por esa firma.
#
# Alternativa sin archivo: exportar RB_KEYSTORE_FILE, RB_KEYSTORE_PASSWORD,
# RB_KEY_ALIAS y RB_KEY_PASSWORD.

storeFile=C:/ruta/FUERA/del/repo/rutbusiness-release.jks
storePassword=
keyAlias=rutbusiness
# Si es la misma que storePassword, se puede dejar vacía.
keyPassword=
