# ============================================================================
# pharma-server — .env.example
# ----------------------------------------------------------------------------
# Env vars consumed by the binary at startup. Loader prefix = PHARMA,
# separator = "__" (double underscore), section/field map 1:1 to AppConfig
# in crates/core/src/config.rs.
#
# Precedence: config/default.toml  <  config/local.toml  <  env PHARMA__*
# Env wins. In production prefer env for ALL secrets.
#
# DO NOT commit a populated .env to git. This file is only the template.
# NEVER paste real secrets here.
#
# Tags:
#   [REQUIRED]   server refuses to start (or starts insecure) without it
#   [optional]   has a sane default in code or default.toml
#   [post-0.1.25] field exists on feat/api-public-orders-web or
#                 feat/api-stock-webhook only; ignored on feature/erp-parity
#                 until merged.
# ============================================================================

# ----------------------------------------------------------------------------
# AppConfig — top-level bind
# Source: AppConfig.bind  (String)
# ----------------------------------------------------------------------------
# [optional, default "0.0.0.0:8080" from config/default.toml]
PHARMA__BIND=0.0.0.0:8080


# ----------------------------------------------------------------------------
# [db] — DbConfig
# Source: crates/core/src/config.rs::DbConfig
# ----------------------------------------------------------------------------
# [optional, default "./data/surreal"]
PHARMA__DB__PATH=./data/surreal
# [optional, default "pharma"]
PHARMA__DB__NAMESPACE=pharma
# [optional, default "main"]
PHARMA__DB__DATABASE=main


# ----------------------------------------------------------------------------
# [jwt] — JwtConfig
# Source: crates/core/src/config.rs::JwtConfig
# ----------------------------------------------------------------------------
# [REQUIRED — SECRET] Generate fresh, never commit a real value:
#   openssl rand -hex 32
# default.toml ships "change-me-in-production" — unsafe for prod.
PHARMA__JWT__SECRET=REPLACE_ME_openssl_rand_hex_32
# [optional, default "pharma-server"]
PHARMA__JWT__ISSUER=pharma-server
# [optional, default 3600]
PHARMA__JWT__TTL_SECONDS=3600


# ----------------------------------------------------------------------------
# [otlp] — OtlpConfig
# Source: crates/core/src/config.rs::OtlpConfig
# ----------------------------------------------------------------------------
# [optional] Empty = OTLP exporter off. Set to gRPC collector URL to enable.
PHARMA__OTLP__ENDPOINT=
# [optional, default "pharma-api"]
PHARMA__OTLP__SERVICE_NAME=pharma-api


# ----------------------------------------------------------------------------
# [metrics] — MetricsConfig
# Source: crates/core/src/config.rs::MetricsConfig
# ----------------------------------------------------------------------------
# [REQUIRED in production — SECRET]
# Empty/unset => GET /metrics returns 401. Generate:
#   openssl rand -hex 24
PHARMA__METRICS__TOKEN=REPLACE_ME_openssl_rand_hex_24


# ----------------------------------------------------------------------------
# [backup] — BackupConfig
# Source: crates/core/src/config.rs::BackupConfig
# ----------------------------------------------------------------------------
# [optional] 6-field cron UTC. Empty/unset disables the scheduler.
PHARMA__BACKUP__SCHEDULE=0 0 3 * * *
# [optional, default 0 = keep forever]
PHARMA__BACKUP__RETENTION_DAYS=30


# ============================================================================
# CLI-only env vars (crates/cli/src/main.rs)
# These are NOT part of AppConfig — read directly by the `pharma` binary.
# ============================================================================

# [optional] Admin token used by `pharma license reload` to call the admin
# endpoint without -t. Falls back to prompt if unset.
# Source: crates/cli/src/main.rs:505
PHARMA_ADMIN_TOKEN=

# [optional] Password for `pharma user-create` non-interactive flow. Falls
# back to interactive prompt if unset.
# Source: crates/cli/src/main.rs:561
PHARMA_PASSWORD=


# ============================================================================
# Second-wave PRs — NOT YET on feature/erp-parity. Leave UNSET on current
# binary; setting them is harmless (deserialize ignores unknown sections)
# but they take effect only after merge.
# ============================================================================

# ----------------------------------------------------------------------------
# [rate_limit] — RateLimitConfig
# [post-0.1.25 — feat/api-public-orders-web]
# ----------------------------------------------------------------------------
# [optional, default true]
PHARMA__RATE_LIMIT__ENABLED=true
# [optional, default 120]
PHARMA__RATE_LIMIT__TENANT_PER_MIN=120
# [optional, default 30]
PHARMA__RATE_LIMIT__TENANT_BURST=30
# [optional, default 60]
PHARMA__RATE_LIMIT__IP_PER_MIN=60
# [optional, default 20]
PHARMA__RATE_LIMIT__IP_BURST=20

# ----------------------------------------------------------------------------
# [public_catalog] — PublicCatalogConfig
# [post-0.1.25 — feat/api-public-orders-web]
# ----------------------------------------------------------------------------
# [optional, default false — opt-in per ADR-0005]
PHARMA__PUBLIC_CATALOG__ENABLED=false
# CORS allow-list: prefer TOML (Vec<String>); env-array support is brittle.

# ----------------------------------------------------------------------------
# [public_orders] — PublicOrdersConfig
# [post-0.1.25 — feat/api-public-orders-web]
# ----------------------------------------------------------------------------
# [optional, default false]
PHARMA__PUBLIC_ORDERS__ENABLED=false
# [REQUIRED if enabled=true — SECRET] Generate: openssl rand -hex 32
PHARMA__PUBLIC_ORDERS__HMAC_SECRET=REPLACE_ME_openssl_rand_hex_32

# ----------------------------------------------------------------------------
# [stock_webhook] — StockWebhookConfig
# [post-0.1.25 — feat/api-stock-webhook]
# ----------------------------------------------------------------------------
# [optional, default false]
PHARMA__STOCK_WEBHOOK__ENABLED=false
# [REQUIRED if enabled=true]
PHARMA__STOCK_WEBHOOK__TARGET_URL=https://tu-farmacia.cl/api/webhooks/pharma-stock
# [REQUIRED if enabled=true — SECRET] Generate: openssl rand -hex 32
PHARMA__STOCK_WEBHOOK__HMAC_SECRET=REPLACE_ME_openssl_rand_hex_32
# [optional, default 3]
PHARMA__STOCK_WEBHOOK__RETRY__TRIES=3
# Backoff Vec<u64> — prefer TOML; env-array brittle.
