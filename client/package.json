{
  "name": "pharma-client",
  "private": true,
  "version": "0.1.0",
  "description": "Pharma Client — Tauri 2 desktop launcher for pharma-server (LoL-style login -> ERP shell)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "gate": "npm run build && npm run test && npm run e2e",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "happy-dom": "^20.10.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  }
}
