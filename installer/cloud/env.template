# /etc/pharma/env — variables de entorno de pharma-api en la VM (root:pharma, chmod 640)
# NUNCA commitear valores reales. Generar secretos con: openssl rand -hex 32

# OJO: el CLI (`pharma`) usa AppConfig::load() ESTRICTO — sin config/*.toml en la
# VM, TODOS los campos sin default de serde deben venir por env o el CLI falla
# con "missing field". pharma-api en cambio usa load_or_default(): si el env está
# incompleto NO falla, cae silencioso a defaults embebidos (bind 0.0.0.0:8080 +
# data ./data/surreal) — api y CLI terminan en DBs DISTINTAS. Mantener este set
# completo siempre.

# Escuchar solo loopback: Caddy hace TLS y proxy desde :443.
PHARMA__BIND=127.0.0.1:8080

# Data dir SurrealKV (disco persistente de la VM).
PHARMA__DB__PATH=/var/lib/pharma/data
PHARMA__DB__NAMESPACE=pharma
PHARMA__DB__DATABASE=main

# Secreto JWT fuerte (openssl rand -hex 32). OBLIGATORIO en prod.
PHARMA__JWT__SECRET=<GENERAR>
PHARMA__JWT__ISSUER=pharma-server
PHARMA__JWT__TTL_SECONDS=3600

# OTLP off (endpoint vacío) pero los campos deben existir para el CLI.
PHARMA__OTLP__ENDPOINT=
PHARMA__OTLP__SERVICE_NAME=pharma-api

# Provisioning key de POST /admin/v1/tenants (SP2). Solo el license-server la
# conoce (header X-Provisioning-Key). Sin la variable el endpoint responde 404
# (instalaciones on-prem NUNCA la setean).
# PHARMA__PROVISIONING__KEY=<GENERAR>

# Swagger UI off en prod endurecida (opcional).
# PHARMA__DOCS__ENABLED=false

# Token de /metrics (vacío = 401 siempre).
# PHARMA__METRICS__TOKEN=<GENERAR>
