<?xml version="1.0" encoding="utf-8"?>
<!--
  pharma-server — WiX installer (cargo-wix / WiX v3 toolset).

  Installs:
    - pharma-service.exe to %ProgramFiles%\PharmaServer\
    - Windows service "PharmaServer" (auto-start, LocalSystem)
    - Data dir %ProgramData%\PharmaServer\
    - Inbound firewall rule on TCP 8080

  Build via cargo-wix; see project README.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:fire="http://schemas.microsoft.com/wix/FirewallExtension">
    <Product Id="*"
             Name="Pharma Server"
             Manufacturer="Pablo Alvarez"
             Version="$(var.Version)"
             UpgradeCode="5E3A2C10-3F3E-4B5A-8C5B-1A2B3C4D5E6F"
             Language="1033">
        <Package InstallerVersion="450"
                 Compressed="yes"
                 InstallScope="perMachine"
                 Description="Pharma Server $(var.Version)"
                 Manufacturer="Pablo Alvarez" />

        <MajorUpgrade DowngradeErrorMessage="A newer version of Pharma Server is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <Feature Id="MainFeature" Title="Pharma Server" Level="1">
            <ComponentGroupRef Id="ServiceComponents" />
            <ComponentGroupRef Id="DataDirComponents" />
        </Feature>

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLFOLDER" Name="PharmaServer" />
            </Directory>
            <Directory Id="CommonAppDataFolder">
                <Directory Id="DATAFOLDER" Name="PharmaServer" />
            </Directory>
        </Directory>

        <ComponentGroup Id="ServiceComponents" Directory="INSTALLFOLDER">
            <Component Id="PharmaServiceExe" Guid="*">
                <File Id="PharmaServiceExeFile"
                      Name="pharma-service.exe"
                      Source="$(var.CargoTargetBinDir)\pharma-service.exe"
                      KeyPath="yes" />

                <ServiceInstall Id="PharmaServiceInstall"
                                Name="PharmaServer"
                                DisplayName="Pharma Server"
                                Description="Pharma Server API host (axum + SurrealDB)."
                                Type="ownProcess"
                                Start="auto"
                                ErrorControl="normal"
                                Vital="yes"
                                Account="LocalSystem"
                                Interactive="no" />

                <ServiceControl Id="PharmaServiceControl"
                                Name="PharmaServer"
                                Start="install"
                                Stop="both"
                                Remove="uninstall"
                                Wait="yes" />

                <fire:FirewallException Id="PharmaApiInbound"
                                        Name="Pharma Server API"
                                        Port="8080"
                                        Protocol="tcp"
                                        Profile="all"
                                        Scope="any" />
            </Component>
        </ComponentGroup>

        <!--
          Data dir holds the customer's SurrealDB (their own data). Per the
          "no data loss / no lock-in" invariant it MUST survive uninstall and
          upgrade. Permanent="yes" guarantees WiX never schedules this folder
          for removal. Do NOT add <RemoveFolder> here.
        -->
        <ComponentGroup Id="DataDirComponents" Directory="DATAFOLDER">
            <Component Id="PharmaDataDir" Guid="7E3A2C10-3F3E-4B5A-8C5B-1A2B3C4D5E71" Permanent="yes">
                <CreateFolder />
            </Component>
        </ComponentGroup>
    </Product>
</Wix>
