<Configuration>
  <VGpu>Disable</VGpu>
  <Networking>Default</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Users\Administrator\Documents\GitHub\pharma-server\target\wix</HostFolder>
      <SandboxFolder>C:\msi</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Users\Administrator\Documents\GitHub\pharma-server\installer\sandbox</HostFolder>
      <SandboxFolder>C:\scripts</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Users\Administrator\Documents\GitHub\pharma-server\installer\sandbox\out</HostFolder>
      <SandboxFolder>C:\out</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -NoExit -ExecutionPolicy Bypass -File C:\scripts\smoke-inside.ps1</Command>
  </LogonCommand>
</Configuration>
