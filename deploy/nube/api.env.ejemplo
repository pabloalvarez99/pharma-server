# Copiar a /etc/rutbusiness/api.env
# chmod 640; chown root:rutbusiness
# Valores reales: CAMBIAME. Generar secretos EN LA CAJA, nunca en el repo.
#   openssl rand -hex 32
#
# El binario lee PHARMA__* (doble guion bajo = nested). Un env incompleto
# hace que pharma-api caiga en defaults (bind 0.0.0.0 + data local) y el
# CLI y la API apuntan a discos distintos. Dejá este set completo.

PHARMA__BIND=127.0.0.1:8080

PHARMA__DB__PATH=/var/lib/rutbusiness/data
PHARMA__DB__NAMESPACE=pharma
PHARMA__DB__DATABASE=main

PHARMA__JWT__SECRET=CAMBIAME
PHARMA__JWT__ISSUER=rutbusiness
PHARMA__JWT__TTL_SECONDS=3600

PHARMA__OTLP__ENDPOINT=
PHARMA__OTLP__SERVICE_NAME=pharma-api

# Sin esta clave, POST /admin/v1/tenants responde 404. La feria no la usa:
# el APK crea negocios con POST /api/v1/alta, que es público.
# PHARMA__PROVISIONING__KEY=CAMBIAME
